# FoodProof — server-only environment (phase-one invited demo)
# Copy to .env.local and fill with values from your DEMO Supabase/Mixpanel projects.
# Never commit real values. Never prefix a secret with NEXT_PUBLIC_.
# Validation rules are enforced in lib/server/env.ts (see comments per var).

# --- Supabase (dedicated DEMO project; the secret key bypasses RLS, keep server-only) ---
# SUPABASE_URL: required, must be a valid https URL.
SUPABASE_URL=
# SUPABASE_SECRET_KEY: required, non-empty. The project's secret key
# (server-only; bypasses RLS). Never sent to the browser; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Mixpanel (dedicated DEMO project; server proxy only) ---
# MIXPANEL_TOKEN: required, non-empty.
MIXPANEL_TOKEN=
# MIXPANEL_API_HOST: required, valid https URL for your data region (e.g. https://api-eu.mixpanel.com).
MIXPANEL_API_HOST=

# --- Application ---
# APP_ORIGIN: required, valid https URL of the deployed origin (used for same-origin checks).
APP_ORIGIN=
# RATE_LIMIT_HMAC_KEY: required, high-entropy secret keying the invitation-attempt limiter HMAC.
RATE_LIMIT_HMAC_KEY=
# DEMO_MODE: required, must be the literal string "true" in phase one.
DEMO_MODE=true

# --- AI (provider/model selected at T4 from then-current official docs; leave blank until then) ---
# AI_PROVIDER: optional in T0; required only once the AI path is enabled.
AI_PROVIDER=
# AI_PROVIDER_API_KEY: optional in T0; required only once the AI path is enabled.
AI_PROVIDER_API_KEY=

# --- Test-only (integration tests) ---
# NOT part of the application environment: it is deliberately absent from the
# ServerEnvSchema in lib/server/env.ts and is never read from lib/ or app/.
# SUPABASE_PUBLISHABLE_KEY: the DEMO project's publishable key (sb_publishable_...),
# the key a browser would hold. It is used by ONE test — the direct-client denial
# test in tests/integration/boundary.test.ts — to prove that a caller holding it
# is refused every table, RPC and Storage operation. Without it that test group is
# SKIPPED with an explicit reason; it never counts as a pass.
SUPABASE_PUBLISHABLE_KEY=
